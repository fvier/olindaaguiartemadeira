# Copie para .env.vps na VPS e restrinja com: chmod 600 .env.vps
DEBUG=False
FLASK_APP=run.py
SECRET_KEY=substitua-por-uma-chave-gerada-com-openssl-rand-hex-32
ASSETS_ROOT=/static

DOMAIN=gpsparaiba.com.br
POSTGRES_DB=gps_paraiba
POSTGRES_USER=gps_paraiba
POSTGRES_PASSWORD=substitua-por-uma-senha-forte
API_INTEGRATION_KEY=substitua-por-uma-chave-de-integracao-forte

